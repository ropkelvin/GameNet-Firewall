<Window x:Class="GameNetFirewall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameNet Firewall" Height="760" Width="1080" MinHeight="640" MinWidth="900"
        Background="#10141D" Foreground="#F3F5F8" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="GAMENET FIREWALL" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Steam game rules, policy preview and recovery tools"
                           Foreground="#AAB4C5" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#263246" CornerRadius="12" Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock Text="DEVELOPMENT BUILD" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Background="#1A2230" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock x:Name="GameCountText" Text="Scanning for installed games…" VerticalAlignment="Center"
                           Foreground="#C2CAD7"/>
                <Button DockPanel.Dock="Right" Content="Rescan" Padding="18,8" Click="Rescan_Click"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1A2230" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10"
                             Padding="10" FontSize="14" ToolTip="Search installed Steam games"
                             TextChanged="SearchBox_TextChanged"/>
                    <ListBox x:Name="GamesList" Background="#111824" Foreground="#F3F5F8"
                             BorderThickness="0" SelectionChanged="GamesList_SelectionChanged"
                             DisplayMemberPath="Name"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#1A2230" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SELECTED GAME" Foreground="#91B6FF" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="SelectedGameName" Text="Choose a game" FontSize="21"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/>
                        <TextBlock x:Name="SelectedGamePath" Text="The install path will appear here."
                                   Foreground="#AAB4C5" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="EXECUTABLE CANDIDATES" FontWeight="Bold" FontSize="13" Margin="0,16,0,7"/>
                        <ComboBox x:Name="ExecutableList" DisplayMemberPath="Name" Padding="7"
                                  ToolTip="Choose the actual game executable; launcher/helper processes may need separate rules."/>
                        <Button Content="Scan Game Folder" Padding="12,8" Margin="0,7,0,0"
                                HorizontalAlignment="Left" Click="ScanExecutables_Click"/>
                        <Separator Margin="0,14,0,14" Background="#344055"/>
                        <TextBlock Text="NETWORK DEPENDENCIES" FontWeight="Bold" FontSize="13" Margin="0,14,0,0"/>
                        <Button Content="Scan Steam / Network Tools" Padding="12,8" Margin="0,7,0,0"
                                Click="ScanDependencies_Click"/>
                        <Button Content="Add VPN / Network Tool Executable…" Padding="12,8" Margin="0,7,0,0"
                                Click="AddNetworkTool_Click"/>
                        <TextBox x:Name="DependenciesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="95" Margin="0,7,0,0"
                                 Background="#111824" Foreground="#C2CAD7" BorderThickness="0"
                                 Text="Not scanned yet."/>
                        <TextBlock Text="This is discovery only; found paths are not automatically allowed." Foreground="#AAB4C5"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Button Content="Add Discovered Steam / VPN Outbound Rules" Padding="12,8" Margin="0,7,0,0"
                                Click="AddDependencyRules_Click"/>
                        <Button Content="Remove Discovered Dependency Rules" Padding="12,8" Margin="0,7,0,0"
                                Click="RemoveDependencyRules_Click"/>
                        <TextBlock Text="These prepare app-specific rules for a future allowlist. They do not block other programs or guarantee VPN tunnel traffic is covered."
                                   Foreground="#AAB4C5" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="NETWORK OPTIONS" FontWeight="Bold" FontSize="13" Margin="0,14,0,0"/>
                        <CheckBox x:Name="NetworkToolCheckBox" Content="I use VPN / network tool"
                                  Margin="0,10,0,0" Foreground="#F3F5F8"/>
                        <TextBlock Text="VPNs and network tools are user-selectable; tunnel and service requirements still need review."
                                   Foreground="#AAB4C5" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Button Content="Preview Actions" Padding="12,9" Margin="0,14,0,0"
                                Click="Preview_Click"/>
                        <Button Content="Back Up Current Firewall Policy" Padding="12,9" Margin="0,7,0,0"
                                Click="Backup_Click"/>
                        <Button Content="Add Game Allow Rules (Inbound + Outbound)" Padding="12,9" Margin="0,7,0,0"
                                Click="ApplyRules_Click"/>
                        <Button Content="Remove GameNet Rules" Padding="12,9" Margin="0,7,0,0"
                                Click="RemoveRules_Click"/>
                        <Button Content="View Current Firewall Profiles" Padding="12,9" Margin="0,7,0,0"
                                Click="ShowProfiles_Click"/>
                        <Button Content="Restore Full Firewall Backup…" Padding="12,9" Margin="0,7,0,0"
                                Click="RestoreBackup_Click"/>
                        <TextBlock x:Name="StatusText" Text="No firewall changes made." Foreground="#AAB4C5"
                                   TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#35261A" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="IMPORTANT: Allow rules do not block other apps. Strict allowlisting requires changing the Windows outbound default policy and can cut off DNS, Steam, Mudfish, voice chat, updates or remote access."
                           Foreground="#FFD79A" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="This build does not change global firewall defaults. Back up first. Run as Administrator for firewall actions."
                           Foreground="#FFD79A" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="GameNet Firewall rules use a dedicated name prefix so they can be removed separately."
                       Foreground="#AAB4C5" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>